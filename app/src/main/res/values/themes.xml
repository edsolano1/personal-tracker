<resources>
    <style name="Theme.Tracker" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">#0F1115</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <!-- Cold start: the icon's rings draw themselves in, then the spark pops (about 0.8s). -->
        <item name="android:windowSplashScreenBackground">#0E1411</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="android:windowSplashScreenAnimationDuration">800</item>
    </style>
</resources>
